#!/bin/sh
. "${CAELESTIA_HOME:-$HOME/.caelestia}/bin/caelestia-env"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"

if [ ! -f "$XDG_STATE_HOME/caelestia/scheme.json" ]; then
    caelestia scheme set -n caelestia >/dev/null 2>&1 || true
fi

config="$XDG_CONFIG_HOME/hypr/hyprland.lua"

if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland -- --config "$config"
fi

exec Hyprland --config "$config"
